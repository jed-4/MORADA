{
  "cli": {
    "version": ">= 12.0.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "ios": {
        "simulator": false,
        "image": "sdk-58"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://buildpro4.replit.app",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_ORG": "buildpro-be",
        "SENTRY_PROJECT": "react-native"
      }
    },
    "simulator": {
      "ios": {
        "simulator": true,
        "image": "sdk-58"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://buildpro4.replit.app",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_ORG": "buildpro-be",
        "SENTRY_PROJECT": "react-native"
      }
    },
    "preview": {
      "distribution": "store",
      "channel": "preview",
      "ios": {
        "buildConfiguration": "Release",
        "image": "sdk-58"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://buildpro4.replit.app",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_ORG": "buildpro-be",
        "SENTRY_PROJECT": "react-native"
      }
    },
    "production": {
      "channel": "production",
      "ios": {
        "buildConfiguration": "Release",
        "image": "sdk-58"
      },
      "android": {
        "buildType": "apk"
      },
      "env": {
        "EXPO_PUBLIC_API_URL": "https://buildpro4.replit.app",
        "SENTRY_DISABLE_AUTO_UPLOAD": "true",
        "SENTRY_ORG": "buildpro-be",
        "SENTRY_PROJECT": "react-native"
      }
    }
  },
  "submit": {
    "preview": {
      "ios": {
        "appleId": "jed4_@hotmail.com",
        "ascAppId": "6759781255"
      }
    },
    "production": {
      "ios": {
        "appleId": "jed4_@hotmail.com",
        "ascAppId": "6759781255"
      }
    }
  }
}
