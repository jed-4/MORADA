# node_modules is ~1.4 GB and is rebuilt inside the image by `npm ci`.
# Copying it in would blow out the build context and can smuggle a
# host-architecture binary (bcrypt, sharp, esbuild) into a Linux image.
node_modules
**/node_modules

# Build output — regenerated by `npm run build`.
dist
client/dist

# Never bake secrets into an image layer.
.env
.env.*
!.env.example

# Mobile / native app trees are not part of the server image.
expo-mobile
ios
android
mobile
.expo

# Local tooling and VCS noise.
.git
.github
.claude
.agents
.canvas
.DS_Store
cookies.txt
*.dump
*.tar.gz
screenshots

# Root-level debugging screenshots. Anchored deliberately: a bare `*.png`
# matches only the context root in .dockerignore, but spelling them out avoids
# anyone "fixing" it into `**/*.png` later — that would drop
# client/public/favicon.png and attached_assets/icon_*.png, and the latter is
# imported by five client components through the @assets alias, so the Vite
# build would fail. attached_assets must stay in the context even though it is
# listed in .gitignore; the icon inside it is tracked.
after-*.png
expo-qr.png
projects-dropdown-open.png
verify-project-in-dropdown.png

# Legacy local upload tree. Nothing writes here any more (see
# server/middleware/uploadsAccess.ts); the files present are test fixtures.
uploads

# Replit workspace config. Not read off Replit, and kept in the repo only
# until the cutover is finished.
.replit
replit.md
