.git
**/node_modules
.DS_Store
server/public
vite.config.ts.*
*.tar.gz
dist

# Database dumps. Backups are taken in the Replit Shell before a hand-applied
# migration and downloaded off the box — they must never be committed, and
# never sit anywhere a build could publish them as a static asset.
*.dump
.expo/
attached_assets

# Env files
.env
.env.local

# Expo env files
expo-mobile/.env
expo-mobile/.env.local

# Replit agent state (large binary files, never include in builds)
.local/state/

# Claude Code: shared config is committed (.claude/settings.json, hooks,
# launch.json); per-machine state is not.
.claude/settings.local.json
.claude/settings.local*.json

# Fingerprint harness output — a local run artefact, diffed by hand, never committed.
/fingerprints/

# Runtime file uploads — contact avatars, e-note attachments, gear photos.
# Written by the app at runtime and by uploads-access.test.ts, which creates
# its own fixtures at setup. Five of those fixtures had been committed by
# accident, so every test run left the tree dirty and the files kept drifting
# in and out of commits.
uploads/
