.git
**/node_modules
.DS_Store
server/public
vite.config.ts.*
*.tar.gz
dist

# Database dumps. Backups are taken in the Replit Shell before a hand-applied
# migration and downloaded off the box — they must never be committed, and
# never sit anywhere a build could publish them as a static asset.
*.dump
.expo/
attached_assets

# Env files
.env
.env.local

# Expo env files
expo-mobile/.env
expo-mobile/.env.local

# Replit agent state (large binary files, never include in builds)
.local/state/

# Claude Code: shared config is committed (.claude/settings.json, hooks,
# launch.json); per-machine state is not.
.claude/settings.local.json
.claude/settings.local*.json
