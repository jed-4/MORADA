# Morada — environment variables
#
# Copy to .env for local development. NEVER commit a filled-in copy.
# Every variable below is one the code actually reads; this file is generated
# from a sweep of process.env across server/, shared/, client/src/, scripts/
# and the two config files.
#
# Note: the env list in replit.md is STALE. It names S3_ACCESS_KEY_ID,
# S3_SECRET_ACCESS_KEY, S3_BUCKET_NAME and S3_ENDPOINT — no code reads any of
# them. Use this file, not that one.


# ══════════════════════════════════════════════════════════════════════════
#  CORE — the app does not run without these
# ══════════════════════════════════════════════════════════════════════════

# Neon Postgres. Also read by drizzle.config.ts, the connect-pg-simple session
# store, and every script under scripts/.
# server/db.ts refuses to boot in production against host "helium" (Replit's
# dev proxy) or ep-muddy-sunset-aelsjwoz... (a stale database).
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# ⚠️  REUSE THE EXISTING VALUE VERBATIM WHEN MIGRATING.
# Signs session cookies, the mobile X-Session-ID → cookie mapping, OAuth state,
# and the HMAC upload grants in server/utils/signedGrant.ts. Changing it logs
# every user out and invalidates every upload grant already issued.
# Required in production — server/index.ts throws at boot without it.
SESSION_SECRET=

# development | production. Selects Vite middleware vs static serving, cookie
# secure/sameSite, Sentry sampling, and whether the schedulers start.
NODE_ENV=development

# Listen port. Render injects this; default 5000.
PORT=5000

# Canonical public URL — no trailing slash. All three OAuth callbacks derive
# from this via server/config/appUrl.ts, so Xero and Google cannot be connected
# until it is right. APP_BASE_URL wins; APP_URL is the older name and is also
# used for Stripe redirects and onboarding email links.
APP_BASE_URL=https://app.moradaco.com.au
APP_URL=https://app.moradaco.com.au

# ⚠️  Required to BOOT, not just to send mail. The Resend client is constructed
# at module load and throws without a key — the "email functionality will not
# work" warning printed just above it is misleading.
RESEND_API_KEY=

# Claude. Powers AI bill reading, SKU extraction, price matching, summaries.
ANTHROPIC_API_KEY=


# ══════════════════════════════════════════════════════════════════════════
#  OBJECT STORAGE — Cloudflare R2 (S3 API)
# ══════════════════════════════════════════════════════════════════════════
# Endpoint is derived: https://<R2_ACCOUNT_ID>.r2.cloudflarestorage.com
# Region is always "auto".

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Supplies the KEY PREFIX for stored objects, in its original
# /<bucket>/<prefix> shape. R2_BUCKET supersedes the leading segment, so this
# value does not need rewriting at cutover — but the prefix must match what the
# objects were copied under, or every stored path 404s.
#   /<bucket>/<prefix>  +  /objects/uploads/<uuid>  ->  <prefix>/uploads/<uuid>
PRIVATE_OBJECT_DIR=/your-bucket/your-prefix

# PUBLIC_OBJECT_SEARCH_PATHS is GONE. It fed searchPublicObject(), which had no
# callers. Do not reintroduce it.


# ══════════════════════════════════════════════════════════════════════════
#  INTEGRATIONS
# ══════════════════════════════════════════════════════════════════════════

# ── Xero ──
# Redirect URI is <APP_BASE_URL>/api/xero/callback and must be registered in
# the Xero developer portal.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
# Verifies the x-xero-signature HMAC on inbound webhooks.
XERO_WEBHOOK_KEY=
# Account code used when mirroring Xero payments.
XERO_DEFAULT_BANK_CODE=
# Debug flag for the P&L / overheads import. Leave unset.
XERO_PL_DIAGNOSTIC=

# ── Google ──
# Sign-in, Calendar, and the Gmail bill inbox share one OAuth client.
# Callbacks: <APP_BASE_URL>/api/google-calendar/callback
#            <APP_BASE_URL>/api/bill-inbox/callback
# Both must be registered in the Google Cloud Console.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Legacy aliases — server/auth.ts falls back to these if the pair above is unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Exactly 32 characters, or token encryption silently disables itself.
# Encrypts stored Google AND Xero refresh tokens at rest.
GOOGLE_OAUTH_ENCRYPTION_KEY=
# Optional explicit override; wins over APP_BASE_URL when set. Useful locally,
# e.g. http://localhost:5000/api/google-calendar/callback
GOOGLE_CALENDAR_REDIRECT_URI=

# ── Stripe ──
# All optional: with STRIPE_SECRET_KEY unset, billing fails soft and no company
# ever hits the paywall.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Read dynamically as STRIPE_PRICE_<PLAN>_<CYCLE>.
STRIPE_PRICE_STUDIO_MONTHLY=
STRIPE_PRICE_STUDIO_ANNUAL=
# Founding-members programme. Unset = off.
STRIPE_FOUNDING_STUDIO_COUPON_ID=
FOUNDING_MEMBER_LIMIT=
# Referral signup discount. Unset = off.
STRIPE_REFEREE_COUPON_ID=

# ── Slack ──
SLACK_WEBHOOK_URL=


# ══════════════════════════════════════════════════════════════════════════
#  OBSERVABILITY
# ══════════════════════════════════════════════════════════════════════════

# Backend DSN. Unset is a clean no-op.
SENTRY_DSN=
# Release identifier. Replaces REPLIT_DEPLOYMENT_ID, which was the previous
# fallback and does not exist off Replit — without it, issues cannot be
# filtered by build.
SENTRY_RELEASE=


# ══════════════════════════════════════════════════════════════════════════
#  BUILD-TIME ONLY  (read by `vite build`, baked into the client bundle)
# ══════════════════════════════════════════════════════════════════════════
# These must be present during the build, not merely at runtime. On Render that
# means the Docker build environment.

# ⚠️  Currently lives in .replit's [userenv] block, NOT in the secrets panel —
# the single easiest variable to lose in this migration. Unset, the Crisp
# support chat widget silently disappears.
VITE_CRISP_WEBSITE_ID=e3620629-080d-4b1e-88b5-821e2adac0fd

# Frontend Sentry — a different DSN from the backend one above.
VITE_SENTRY_DSN=
VITE_SENTRY_RELEASE=

# Gate source-map upload; also switches on `sourcemap: true` in vite.config.ts.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Set only by the Expo mobile build. Its PRESENCE is how shared code detects
# "this is mobile", so never set it for the web build.
# VITE_API_BASE_URL=


# ══════════════════════════════════════════════════════════════════════════
#  MUST NEVER BE SET IN PRODUCTION
# ══════════════════════════════════════════════════════════════════════════

# Injects a logged-in user and bypasses authentication entirely. Local only.
# DEV_USER_EMAIL=you@example.com

# A separate, STALE database with an outdated schema. server/db.ts hard-blocks
# it, and scripts/apply-migration.ts refuses to migrate it. Do not carry it to
# the new host at all.
# NEON_DATABASE_URL=

# Supplied by Replit. Kept in the base-URL fallback chain below
# APP_BASE_URL/APP_URL so the existing deployment is unaffected until cutover;
# there is no reason to set either one anywhere else.
# REPLIT_DOMAINS=
# REPLIT_DEV_DOMAIN=


# ══════════════════════════════════════════════════════════════════════════
#  MISC
# ══════════════════════════════════════════════════════════════════════════

# Kill switch for the hourly trial-lifecycle email sweep.
ONBOARDING_EMAILS_ENABLED=
# Deploy-verification marker.
PROBE_STAMP=
